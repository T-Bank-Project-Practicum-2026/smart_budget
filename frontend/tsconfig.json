{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],

      "@app/*": ["./src/app/*"],

      "@entities/*": ["./src/entities/*"],

      "@features/*": ["./src/features/*"],

      "@pages": ["./src/pages/index.ts"],
      "@pages/*": ["./src/pages/*"],

      "@shared/*": ["./src/shared/*"],

      "@widgets/*": ["./src/widgets/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
