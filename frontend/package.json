    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "sass-embedded": "^1.105.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
