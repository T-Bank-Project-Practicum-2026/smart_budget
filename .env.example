FRONTEND_PORT=3000

APP_ORIGINS=http://localhost:3000,http://localhost:5173
VAPID_SUBJECT=mailto:admin@example.com
# Set true when serving over HTTPS.
AUTH_COOKIE_SECURE=false

# make init generates missing secrets and preserves existing values.
POSTGRES_PASSWORD=
API_DB_PASSWORD=
WORKER_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
JWT_SECRET=
NOTIFICATIONS_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

POSTGRES_IMAGE=postgres:18.6-alpine
POSTGRES_VOLUME_TARGET=/var/lib/postgresql
